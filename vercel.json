{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/robots.txt", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/llms.txt", "destination": "/api/index" },
    { "source": "/humans.txt", "destination": "/api/index" },
    { "source": "/.well-known/security.txt", "destination": "/api/index" },
    { "source": "/favicon.ico", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
