# WeHelpTeachers server config — copy to .env for local `python server.py`.
# On Vercel: Project Settings → Environment Variables. Real keys are NEVER
# committed to git (this file holds names only).
NVIDIA_API_KEY=
# Optional (defaults shown):
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_RPM=39
# APP_SECRET=   (set a random string to lock /api to your own frontend)

# Crop-first student OCR. "auto" enables it as soon as a vision provider is
# configured; set to 0 to keep the whole-document extraction path.
# VISION_STUDENT=auto

# Optional second transcription opinion (vision-capable model id required):
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
