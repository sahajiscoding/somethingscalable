# WeHelpTeachers server config — copy to .env for local `python server.py`.
# On Vercel: Project Settings → Environment Variables. Real keys are NEVER
# committed to git (this file holds names only).
# "WHT Engine" is this product's AI layer; it runs on the Kilo Gateway.
# Use the key from https://app.kilo.ai/profile (KILO_API_KEY is canonical;
# WHT_ENGINE_API_KEY is also read so older deployments keep working).
# When anonymous free-model calls fail, the server uses this key for the
# listed free backups; it is never sent to the browser. Kilo's free-model
# availability, pricing and account rate limits can change. Free providers
# may retain or train on submitted content; avoid personal or confidential data.
KILO_API_KEY=
# Optional (defaults shown):
# WHT_ENGINE_MODEL=nvidia/nemotron-3.5-super-vl:free
# WHT_ENGINE_API_URL=https://api.kilo.ai/api/gateway/chat/completions
# WHT_ENGINE_RPM=3            (self-imposed calls/minute; Kilo free = 200/hour)
# Model-call budgets — multi-page vision needs 30-60 s. On a 429 the engine
# moves to the next compatible free model rather than waiting on that model.
# WHT_ENGINE_TIMEOUT=90       (per-request read timeout, seconds)
# WHT_ENGINE_WALL_BUDGET=200  (total LLM time per extraction call, seconds)
# APP_SECRET=   (set a random string to lock /api to your own frontend)

# Crop-first student OCR. "auto" enables it as soon as a vision provider is
# configured; set to 0 to keep the whole-document extraction path.
# VISION_STUDENT=auto

# Optional second transcription opinion (vision-capable model id required):
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
