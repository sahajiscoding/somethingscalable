# Exam Checker server config — copy to .env for local `python server.py`.
# On Vercel: Project Settings → Environment Variables. Real keys are NEVER
# committed to git (this file holds names only).
NVIDIA_API_KEY=
# Optional (defaults shown):
# NVIDIA_MODEL=moonshotai/kimi-k3
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_RPM=39
# APP_SECRET=   (set a random string to lock /api to your own frontend)
# GEMINI_API_KEY=   (only if you use the Gemini backend via CLI/Streamlit)
# GEMINI_MODEL=gemini-3.8-flash
