# Copy to .env for local runs. On Vercel, set these in
# Project Settings → Environment Variables instead.
# Use ONE provider: a Gemini key, or an nvapi-... NVIDIA key (auto-detected).
GEMINI_API_KEY=
# NVIDIA_API_KEY=
# Optional model overrides (must match a model id your key can access)
# GEMINI_MODEL=gemini-3.8-flash
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
