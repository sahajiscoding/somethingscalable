# WeHelpTeachers server config — copy to .env for local `python server.py`.
# On Vercel: Project Settings → Environment Variables. Real keys are NEVER
# committed to git (this file holds names only).
WHT_ENGINE_API_KEY=
# Optional (defaults shown):
# WHT_ENGINE_MODEL=nvidia/nemotron-3.5-super-vl:free
# WHT_ENGINE_API_URL=https://ai-gateway.wht-engine.ai/api/v1/chat/completions
# WHT_ENGINE_RPM=39
# Model-call budgets — the WHT Engine free tier needs 30-60 s for multi-page
# vision; raise these if you see "Timed out after Ns" in the error banner.
# WHT_ENGINE_TIMEOUT=90       (per-request read timeout, seconds)
# WHT_ENGINE_WALL_BUDGET=200  (total LLM time per extraction call, seconds)
# APP_SECRET=   (set a random string to lock /api to your own frontend)

# Crop-first student OCR. "auto" enables it as soon as a vision provider is
# configured; set to 0 to keep the whole-document extraction path.
# VISION_STUDENT=auto

# Optional second transcription opinion (vision-capable model id required):
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
